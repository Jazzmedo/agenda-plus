{
	"name": "agenda-plus",
	"version": "1.0.0",
	"description": "Manage tasks and events in a month, week and day calendar, with recurring tasks, event countdowns, priority tags and completion statistics.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ct-test.mjs && node node_modules/.cache/ct-test.mjs",
		"deploy": "node scripts/deploy.mjs",
		"release": "npm run build && npm run deploy"
	},
	"keywords": [],
	"author": "Jazzmedo",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0"
	}
}
